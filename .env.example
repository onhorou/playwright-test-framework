# ---------------------------------------------------------------------------
# Шаблон переменных окружения.
# Скопируйте этот файл в `.env` (в корне проекта) и подставьте свои значения.
# `.env` не коммитится в Git — в репозиторий попадает только этот шаблон.
# ---------------------------------------------------------------------------

# Базовый URL тестируемого приложения (используется для API- и UI-тестов).
BASE_URL=http://localhost:8000

# Строка подключения к базе данных PostgreSQL (клиент psycopg).
# Формат: postgresql://<user>:<password>@<host>:<port>/<database>
DB_URL=postgresql://user:password@localhost:5432/database
